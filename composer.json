{
    "name": "carlosalbertoxw/crud-servicios-rest-php-oo",
    "description": "Servicio REST de notas en PHP orientado a objetos, sin framework: autenticación por API key, aislamiento multi-tenant, paginación por keyset, búsqueda de texto completo, rate limiting y health checks.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
